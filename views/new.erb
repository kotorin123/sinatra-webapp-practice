<form action="/memos" method="POST">

  <div class="form-area">
    <label>タイトル</label>
    <input type="text" name="title" required>
  </div>

  <div class="form-area">
    <label>内容</label>
    <textarea name="content" required></textarea>
  </div>

  <div class="actions">
    <input type="submit" value="保存">
    <button type="button" onclick="location.href='/memos'">キャンセル</button>
  </div>

</form>
