<h2>編集</h2>

<form action="/memos/<%= @memo["id"] %>" method="POST">
  <input type="hidden" name="_method" value="patch">

  <div class="form-area">
    <label>タイトル</label>
    <input type="text" value="<%= h @memo["title"] %>" name="title" required>
  </div>

  <div class="form-area">
    <label>内容</label>
    <textarea name="content" required><%= h @memo["content"] %></textarea>
  </div>

  <div class="actions">
    <input type="submit" value="変更">
    <a href="/memos">キャンセル</a>
  </div>

</form>
