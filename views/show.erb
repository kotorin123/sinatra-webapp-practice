<nav class="actions">
  <button onclick="location.href='/memos'">トップへ戻る</button>
</nav>

<section>
  <h2><%= h @memos_list[@memo_id]["title"] %></h2>
  <p class="memo_content"><%= h @memos_list[@memo_id]["content"] %></p>
</section>

<div class="actions">
  <button onclick="location.href='/memos/<%= @memo_id %>/edit'">変更 </button>

  <form action="/memos/<%= @memo_id %>" method="POST">
    <input type="submit" value="削除" onclick="return confirm('削除しますか？');">
    <input type="hidden" name="_method" value="delete">
  </form>
</div>
