<nav class="actions">
  <a href="/memos">トップへ戻る</a>
</nav>

<section>
  <h2><%= h @memo[:title] %></h2>
  <p class="memo_content"><%= h @memo[:content] %></p>
</section>

<div class="actions">
  <a href="/memos/<%= @memo[:memo_id] %>/edit">変更</a>

  <form action="/memos/<%= @memo[:memo_id] %>" method="POST">
    <input type="submit" value="削除" onclick="return confirm('削除しますか？');">
    <input type="hidden" name="_method" value="delete">
  </form>
</div>
